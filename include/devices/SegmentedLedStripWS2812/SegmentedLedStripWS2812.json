{
  "$schema": "../device.schema.json",
  "schemaVersion": 1,
  "deviceType": {
    "name": "SegmentedLedStrip",
    "className": "SegmentedLedStripWS2812",
    "enumSymbol": "type_SEGMENTED_LED_STRIP",
    "enumValue": 53,
    "httpConfig": { "displayName": "Segmented LED strip" }
  },
  "implementation": {
    "header": "include/devices/SegmentedLedStripWS2812/SegmentedLedStripWS2812.hpp",
    "source": "src/device/SegmentedLedStripWS2812/SegmentedLedStripWS2812.cpp",
    "buildGuard": "LED_STRIP_SUPPORTED",
    "dependencies": ["Adafruit_NeoPixel", "LedStrip animation framework"],
    "factory": { "arguments": ["config", "persistentDataChanged"] },
    "configurationValidator": "SegmentedLedStripWS2812::isConfigurationValid",
    "manager": {
      "registered": true,
      "collection": "DeviceManager::ledws2812bDevices",
      "includedInDeviceCollection": true
    }
  },
  "lifecycle": {
    "init": { "actions": [] },
    "update": {
      "entryPoint": "cyclic",
      "schedule": {
        "mode": "every_manager_cycle",
        "internalTasks": [
          { "name": "transition animation", "cadence": "animationWaitTicks manager cycles per segment", "defaultTicks": 4 },
          { "name": "live animation", "cadence": "7 manager cycles per segment", "defaultTicks": 7 }
        ]
      }
    }
  },
  "configuration": {
    "commonFields": [
      { "name": "enabled", "type": "boolean", "source": "isActive", "widget": "checkbox" },
      { "name": "name", "type": "string", "source": "deviceName", "maximumLength": 24, "widget": "text" },
      { "name": "pin", "type": "uint8", "source": "pinNumber", "widget": "gpio-select" },
      { "name": "id", "type": "uint8", "source": "deviceId", "widget": "device-slot" },
      { "name": "room", "type": "uint8", "source": "roomId", "widget": "room-select" }
    ],
    "customBytes": [
      { "name": "physicalLedCount", "type": "uint16", "label": "Total LEDs (sum of segments)", "fieldId": "ledsCount", "htmlType": "number", "offset": 0, "size": 2, "minimum": 1, "maximum": 2040, "byteOrder": "native", "widget": "number" },
      { "name": "currentLimit", "type": "uint8", "label": "Current limiter", "fieldId": "curLim", "htmlType": "range", "offset": 2, "size": 1, "minimum": 15, "maximum": 254, "unit": "pwm", "widget": "range", "zeroMeans": "100 percent" },
      { "name": "colorOrder", "type": "uint8", "label": "Color order", "fieldId": "colorOrder", "htmlType": "select", "offset": 3, "size": 1, "widget": "select", "options": [{"value": 0, "label": "Default (GRB)"}, {"value": 1, "label": "RGB"}, {"value": 2, "label": "BRG"}, {"value": 3, "label": "RBG"}, {"value": 4, "label": "GBR"}, {"value": 5, "label": "BGR"}], "default": 0 },
      { "name": "segmentCount", "type": "uint8", "label": "Segments (max 8, SuperMini 4)", "fieldId": "segCount", "htmlType": "number", "offset": 4, "size": 1, "minimum": 1, "maximum": 8, "widget": "number", "default": 1 },
      { "name": "segmentLayout", "type": "uint8[9]", "label": "Segments", "fieldId": "segLayout", "htmlType": "segment-layout", "offset": 5, "size": 9, "arrayLength": 8, "maximum": 255, "widget": "segment-layout", "description": "Bytes 5..12 hold LED counts per segment, byte 13 holds the flip bitmask (bit N reverses segment N)" },
      { "name": "currentLimitSafetyCopy", "type": "uint8", "label": "Current limiter copy", "fieldId": "currentLimitSafetyCopy", "htmlType": "hidden", "offset": 19, "size": 1, "widget": null, "mustEqual": "currentLimit" }
    ]
  },
  "services": [
    {
      "name": "DEVSERVICE_STATE_SWITCH",
      "overload": "serviceCall_1",
      "status": "implemented",
      "parameters": [
        { "name": "state", "type": "uint8", "source": "ServiceParameters_set1.a", "description": "0 off, 1 on, 2 toggle (any segment on turns all off)" }
      ]
    },
    {
      "name": "DEVSERVICE_SEGMENT_STATE_SWITCH",
      "overload": "serviceCall_1",
      "status": "implemented",
      "parameters": [
        { "name": "segment", "type": "uint8", "source": "ServiceParameters_set1.a", "description": "0-based segment index" },
        { "name": "state", "type": "uint8", "source": "ServiceParameters_set1.b", "description": "0 off, 1 on, 2 toggle" }
      ]
    },
    {
      "name": "DEVSERVICE_LIVE_ANIMATION",
      "overload": "serviceCall_1",
      "status": "implemented",
      "parameters": [
        { "name": "state", "type": "uint8", "source": "ServiceParameters_set1.a", "description": "0 stop, 1 start, 2 toggle" },
        { "name": "segment", "type": "uint8", "source": "ServiceParameters_set1.b", "description": "0-based segment index, 255 for all segments" }
      ]
    },
    {
      "name": "DEVSERVICE_GET_ADVANCED_CONTROLS",
      "overload": "serviceCall_3",
      "status": "implemented",
      "parameters": [
        { "name": "data", "type": "LedStripAnimationProperties[8] + LedColor[]", "source": "ServiceParameters_set3.buff", "direction": "out", "size": "virtualLedCount * sizeof(LedColor) + 8 * sizeof(LedStripAnimationProperties)" }
      ]
    },
    {
      "name": "DEVSERVICE_SET_ADVANCED_CONTROLS",
      "overload": "serviceCall_3",
      "status": "implemented",
      "parameters": [
        { "name": "data", "type": "LedStripAnimationProperties[8] + LedColor[]", "source": "ServiceParameters_set3.buff", "direction": "in", "size": "virtualLedCount * sizeof(LedColor) + 8 * sizeof(LedStripAnimationProperties)" }
      ]
    },
    {
      "name": "DEVSERVICE_GET_DETAILED_COLORS",
      "overload": "serviceCall_3",
      "status": "implemented",
      "parameters": [
        { "name": "data", "type": "LedStripAnimationProperties[8] + LedColor[]", "source": "ServiceParameters_set3.buff", "direction": "out", "size": "virtualLedCount * sizeof(LedColor) + 8 * sizeof(LedStripAnimationProperties)" }
      ]
    },
    {
      "name": "DEVSERVICE_SET_DETAILED_COLORS",
      "overload": "serviceCall_3",
      "status": "implemented",
      "parameters": [
        { "name": "data", "type": "LedStripAnimationProperties[8] + LedColor[]", "source": "ServiceParameters_set3.buff", "direction": "in", "size": "virtualLedCount * sizeof(LedColor) + 8 * sizeof(LedStripAnimationProperties)" }
      ]
    },
    {
      "name": "DEVSERVICE_SET_EXT_MEMORY_PTR",
      "overload": "serviceCall_3",
      "status": "implemented",
      "parameters": [
        { "name": "memory", "type": "byte[]", "source": "ServiceParameters_set3.buff", "direction": "in", "size": "getExtendedMemoryLength()" }
      ]
    }
  ],
  "digitalEventActions": [
    { "id": 21, "label": "Turn on (all segments)", "service": "DEVSERVICE_STATE_SWITCH", "parameters": { "a": 1 } },
    { "id": 22, "label": "Turn off (all segments)", "service": "DEVSERVICE_STATE_SWITCH", "parameters": { "a": 0 } },
    { "id": 23, "label": "Toggle (all segments)", "service": "DEVSERVICE_STATE_SWITCH", "toggleState": true },
    { "id": 43, "label": "Start live animation (all segments)", "service": "DEVSERVICE_LIVE_ANIMATION", "parameters": { "a": 1, "b": 255 } },
    { "id": 44, "label": "Stop live animation (all segments)", "service": "DEVSERVICE_LIVE_ANIMATION", "parameters": { "a": 0, "b": 255 } }
  ],
  "enablingConditions": [
    { "id": 1, "label": "Enabled", "source": "isEnabled", "type": "boolean", "comparator": "equals", "value": true },
    { "id": 2, "label": "Disabled", "source": "isEnabled", "type": "boolean", "comparator": "equals", "value": false }
  ],
  "state": {
    "enabledSemantics": "any segment on",
    "descriptionCustomBytes": [
      { "name": "virtualLedCount", "type": "uint8", "offset": 0, "size": 1 },
      { "name": "segmentCount", "type": "uint8", "offset": 1, "size": 1 },
      { "name": "segmentOn", "type": "boolean[8]", "offset": 2, "size": 8 },
      { "name": "segmentLive", "type": "boolean[8]", "offset": 10, "size": 8 },
      { "name": "segmentVirtualLedCount", "type": "uint8[8]", "offset": 18, "size": 8 },
      { "name": "segmentAverageColors", "type": "rgb888[8]", "offset": 26, "size": 24 }
    ],
    "httpFields": [
      { "name": "segCount", "type": "uint8", "source": "customBytes[1]" },
      { "name": "segOn", "type": "boolean[8]", "source": "customBytes[2..9]" },
      { "name": "segLive", "type": "boolean[8]", "source": "customBytes[10..17]" },
      { "name": "segVirt", "type": "uint8[8]", "source": "customBytes[18..25]" },
      { "name": "segColors", "type": "hex-color[8]", "source": "customBytes[26..49]" }
    ]
  },
  "ui": {
    "roomWidget": "generateSegmentedLedStripWidget",
    "advancedControls": {
      "template": "include/devices/SegmentedLedStripWS2812/AdvancedControls.html",
      "payloadSize": {
        "countState": "virtualLedCount",
        "maximumCount": 100,
        "elementBytes": 3,
        "overheadBytes": 40
      }
    },
    "controls": [
      { "name": "segmentSelect", "widget": "segment-select", "countSource": "segCount", "stateSource": "segOn", "liveSource": "segLive" },
      { "name": "power", "widget": "toggle-button", "displayOrder": 2, "service": "DEVSERVICE_STATE_SWITCH", "overload": "serviceCall_1" },
      { "name": "advanced", "widget": "settings-button", "displayOrder": 0, "service": "DEVSERVICE_GET_ADVANCED_CONTROLS", "overload": "serviceCall_3" },
      { "name": "liveAnimation", "widget": "play-stop-button", "displayOrder": 1, "service": "DEVSERVICE_LIVE_ANIMATION", "overload": "serviceCall_1" }
    ],
    "readouts": [
      { "name": "segmentColors", "widget": "segment-color-array", "countSource": "segCount", "colorSource": "segColors", "stateSource": "segOn" }
    ]
  },
  "extendedMemory": {
    "required": true,
    "size": "virtualLedCount * sizeof(LedColor) + 8 * sizeof(LedStripAnimationProperties)",
    "layout": ["active content of all segments", "animation properties of 8 segments (5 bytes each)"]
  },
  "limitations": [
    "Total virtual diodes are limited to 100 (50 on ESP32-S3 SuperMini); more physical diodes are merged per virtual diode.",
    "Segments are limited to 8 (4 on ESP32-S3 SuperMini). A configuration whose segment LED counts do not add up to the total is rejected and the device is not created.",
    "Saved color presets are not supported.",
    "Live animation is started per segment; a segment that is off is switched on first.",
    "Advanced-controls enableAnimation values: 0 roll left, 1 roll right, 2 fade, 3 bounce, 4 falling stars, 5 color shuffle. disableAnimation values: 0 fade out, 1 roll out right, 2 roll out left, 3 blinking sky, 4 supernova."
  ]
}
