{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://homecontrolstation.local/schemas/device.schema.json",
  "title": "HomeControlStation device metadata",
  "type": "object",
  "required": [
    "schemaVersion",
    "deviceType",
    "implementation",
    "lifecycle",
    "configuration",
    "services",
    "state",
    "ui",
    "extendedMemory",
    "limitations"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "deviceType": {
      "type": "object",
      "required": ["name", "className", "enumSymbol", "enumValue"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "className": { "type": "string", "minLength": 1 },
        "enumSymbol": { "type": ["string", "null"] },
        "enumValue": { "type": "integer", "minimum": 0, "maximum": 255 },
        "httpConfig": {
          "type": "object",
          "properties": {
            "group": { "type": "string" },
            "displayName": { "type": "string" },
            "renderer": { "type": "string" },
            "configWidget": { "type": "string" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "implementation": {
      "type": "object",
      "required": ["header", "source", "buildGuard", "dependencies", "manager"],
      "properties": {
        "header": { "type": "string" },
        "source": { "type": "string" },
        "buildGuard": { "type": ["string", "null"] },
        "dependencies": {
          "type": "array",
          "items": { "type": "string" }
        },
        "manager": {
          "type": "object",
          "required": ["registered", "collection", "includedInDeviceCollection"],
          "properties": {
            "registered": { "type": "boolean" },
            "collection": { "type": ["string", "null"] },
            "includedInDeviceCollection": { "type": "boolean" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "lifecycle": {
      "type": "object",
      "required": ["init", "update"],
      "properties": {
        "init": { "type": "object" },
        "update": {
          "type": "object",
          "required": ["entryPoint", "schedule"],
          "properties": {
            "entryPoint": { "const": "cyclic" },
            "schedule": {
              "type": "object",
              "required": ["mode"],
              "properties": {
                "mode": {
                  "enum": ["every_manager_cycle", "not_registered"]
                }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "configuration": {
      "type": "object",
      "required": ["commonFields", "customBytes"],
      "properties": {
        "commonFields": {
          "type": "array",
          "items": { "$ref": "#/$defs/field" }
        },
        "customBytes": {
          "type": "array",
          "items": { "$ref": "#/$defs/field" }
        }
      },
      "additionalProperties": true
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "overload", "status", "parameters"],
        "properties": {
          "name": { "type": "string" },
          "overload": {
            "enum": [
              "serviceCall_NoParams",
              "serviceCall_1",
              "serviceCall_2",
              "serviceCall_3"
            ]
          },
          "status": {
            "enum": ["implemented", "placeholder", "disabled"]
          },
          "parameters": {
            "type": "array",
            "items": { "$ref": "#/$defs/field" }
          }
        },
        "additionalProperties": true
      }
    },
    "state": {
      "type": "object",
      "required": ["descriptionCustomBytes", "httpFields"],
      "properties": {
        "descriptionCustomBytes": {
          "type": "array",
          "items": { "$ref": "#/$defs/field" }
        },
        "httpFields": {
          "type": "array",
          "items": { "$ref": "#/$defs/field" }
        }
      },
      "additionalProperties": true
    },
    "ui": {
      "type": "object",
      "required": ["roomWidget", "controls", "readouts"],
      "properties": {
        "roomWidget": { "type": ["string", "null"] },
        "controls": {
          "type": "array",
          "items": { "$ref": "#/$defs/control" }
        },
        "readouts": {
          "type": "array",
          "items": { "$ref": "#/$defs/control" }
        }
      },
      "additionalProperties": true
    },
    "extendedMemory": {
      "type": "object",
      "required": ["required", "size"],
      "properties": {
        "required": { "type": "boolean" },
        "size": { "type": ["integer", "string"] }
      },
      "additionalProperties": true
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "field": {
      "type": "object",
      "required": ["name", "type"],
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string" },
        "label": { "type": "string" },
        "fieldId": { "type": "string" },
        "htmlType": { "type": "string" },
        "offset": { "type": "integer", "minimum": 0 },
        "size": { "type": "integer", "minimum": 1 },
        "source": { "type": "string" },
        "unit": { "type": "string" },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "default": {},
        "widget": { "type": ["string", "null"] },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["value", "label"],
            "properties": {
              "value": {},
              "label": { "type": "string" }
            },
            "additionalProperties": true
          }
        },
        "arrayLength": { "type": "integer", "minimum": 1 },
        "segmentCount": { "type": "integer", "minimum": 1 },
        "zeroMeans": { "type": "string" },
        "mustEqual": { "type": "string" }
      },
      "additionalProperties": true
    },
    "control": {
      "type": "object",
      "required": ["name", "widget"],
      "properties": {
        "name": { "type": "string" },
        "widget": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
